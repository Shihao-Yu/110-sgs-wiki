{
  "name": "@sgs/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --trace-uncaught ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true }); require('fs').rmSync('out', { recursive: true, force: true });\" && node --trace-uncaught ./node_modules/next/dist/bin/next build",
    "start": "node --trace-uncaught ./node_modules/next/dist/bin/next start",
    "lint": "node --trace-uncaught ./node_modules/next/dist/bin/next lint"
  },
  "dependencies": {
    "@sgs/data": "workspace:*",
    "@sgs/engine": "workspace:*",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
